{
  // The shared Docusaurus config still declares baseUrl, removed in TypeScript 7.
  "include": ["./src", "./*.ts"],
  "exclude": ["node_modules", "build", ".docusaurus"],
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  }
}
